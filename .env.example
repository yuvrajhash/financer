# Execution assumptions - verify against the active NSE contract before testing.
PAPER_TICK_SIZE=0.0025
PAPER_LOT_SIZE=1000
PAPER_SLIPPAGE_TICKS=1
PAPER_ROUND_TRIP_COST=40

# Persistence
SQLITE_PATH=financer.sqlite3
